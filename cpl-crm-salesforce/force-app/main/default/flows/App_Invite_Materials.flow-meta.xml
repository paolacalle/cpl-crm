    <decisions>
        <description>Only complete the stage task when the user confirms the stage is ready to close.</description>
        <name>Decision_Complete_Stage</name>
        <label>Complete Stage?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stage_Saved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Keep Open</defaultConnectorLabel>
        <rules>
            <name>Yes_Complete_Stage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Complete_Stage_Now</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Stage_Task</targetReference>
            </connector>
            <label>Yes - Complete</label>
        </rules>
    </decisions>
    <decisions>
        <description>Move the application forward based on the material checklist.</description>
        <name>Decision_Update_Status</name>
        <label>Update Application Status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Stage_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No status update</defaultConnectorLabel>
        <rules>
            <name>Materials_Complete</name>
            <conditionLogic>1 AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>Resume_Received</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Essay_Received</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Coach_Recommendation_Received</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Internship_Recommendation_Received</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Status_In_Review</targetReference>
            </connector>
            <label>Materials Complete</label>
        </rules>
        <rules>
            <name>Invite_Accepted_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Invite_Accepted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Status_Collecting_Documents</targetReference>
            </connector>
            <label>Invite Accepted</label>
        </rules>
    </decisions>
    <decisions>
        <description>Skip the Task update if the seeded stage Task is missing.</description>
        <name>Has_Stage_Task</name>
        <label>Has Stage Task?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stage_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Task Missing</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Stage_Task.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Complete_Stage_Task</targetReference>
            </connector>
            <label>Yes - Has Task</label>
        </rules>
    </decisions>
    <description>Single-screen Application action plan stage for scholarship invite, invite acceptance, materials link, material checklist, and missing-materials follow-up.</description>
    <environments>Default</environments>
    <formulas>
        <name>defaultInviteBody</name>
        <dataType>String</dataType>
        <expression>&quot;Hi &quot; &amp; BLANKVALUE({!Get_App.Applicant_Account__r.FirstName}, &quot;there&quot;) &amp; &quot;,&quot; &amp; BR() &amp; BR() &amp;
&quot;I am so excited that you have decided that a career in Wealth Management as a Financial Advisor is your goal. I am also delighted to share that you have been selected as a CPL Scholar Finalist.&quot; &amp; BR() &amp; BR() &amp;
&quot;This recognition reflects both your accomplishments to date and your potential to contribute to a community of exceptional women who are committed to guiding, lifting, and inspiring one another throughout their careers. By joining this elite group, you will not only benefit from their wisdom and support — you will also be expected to extend the same to others as you grow.&quot; &amp; BR() &amp; BR() &amp;
&quot;To complete the review process, please submit all your materials to the link provided below.&quot; &amp; BR() &amp; BR() &amp;
&quot;• Your most recent resume, including GPA, leadership activities, and athletic achievements&quot; &amp; BR() &amp; BR() &amp;
&quot;• Two letters of recommendation:&quot; &amp; BR() &amp;
&quot;- One from your coach or a college professor&quot; &amp; BR() &amp;
&quot;- One from your summer internship supervisor&quot; &amp; BR() &amp; BR() &amp;
&quot;• If applicable, a list of any financial aid, scholarships, or grants you are receiving or have received&quot; &amp; BR() &amp; BR() &amp;
&quot;• A short essay describing your commitment to living out the CPL mantra, your aspirations for a career in wealth management, and any additional personal story you’d like to share that will strengthen your application&quot; &amp; BR() &amp; BR() &amp;
&quot;Please submit all your application to this &quot; &amp; BLANKVALUE({!Materials_URL}, BLANKVALUE({!defaultMaterialsURL}, &quot;blank url&quot;)) &amp; &quot;.&quot; &amp; BR() &amp; BR() &amp;
&quot;If you are selected as a CPL Scholar, you will receive a $10,000 scholarship/grant for your senior year. More importantly, you will gain lifelong access to a network of extraordinary women — and I will personally serve as your coach and mentor.&quot; &amp; BR() &amp; BR() &amp;
&quot;Together, we will build this community and continue our mission to change the face of wealth management — and by extension, the world.&quot; &amp; BR() &amp; BR() &amp;
&quot;Congratulations once again on being selected as a CPL Scholar Finalist. I cannot wait to see the impact you will make in this next chapter.&quot; &amp; BR() &amp; BR() &amp;
&quot;With pride and excitement,&quot; &amp; BR() &amp; BR() &amp;
&quot;Lisa&quot;</expression>
    </formulas>
    <formulas>
        <name>defaultMaterialsURL</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_App.Materials_Form_URL__c})),
  {!Get_App.Materials_Form_URL__c},
  IF(NOT(ISBLANK({!$Setup.CPL_Config__c.JotForm_Materials_Base_URL__c})),
    {!$Setup.CPL_Config__c.JotForm_Materials_Base_URL__c}
      &amp; &quot;?appid=&quot; &amp; {!recordId}
      &amp; &quot;&amp;q3_fullname1%5Bfirst%5D=&quot; &amp; URLENCODE(BLANKVALUE({!Get_App.Applicant_Account__r.FirstName}, &quot;&quot;))
      &amp; &quot;&amp;q3_fullname1%5Blast%5D=&quot; &amp; URLENCODE(BLANKVALUE({!Get_App.Applicant_Account__r.LastName}, &quot;&quot;))
      &amp; &quot;&amp;q4_email2=&quot; &amp; URLENCODE(BLANKVALUE({!Get_App.Applicant_Account__r.PersonEmail}, &quot;&quot;)),
    &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>defaultMissingBody</name>
        <dataType>String</dataType>
        <expression>&quot;Hi &quot; &amp; BLANKVALUE({!Get_App.Applicant_Account__r.FirstName}, &quot;there&quot;) &amp; &quot;,&quot; &amp; BR() &amp; BR() &amp; &quot;I wanted to follow up on your CPL Scholar finalist materials. We are still missing one or more required materials from your application file. Please use the link below to submit anything outstanding:&quot; &amp; BR() &amp; BR() &amp; {!Materials_URL} &amp; BR() &amp; BR() &amp; &quot;Thank you,&quot; &amp; BR() &amp; &quot;CPL Team&quot;</expression>
    </formulas>
