    <description>Updates only supplied title, note and interaction date on an existing interaction. Omitted/blank inputs preserve existing fields. Does not change Contact, Lead, owner, topics or links. Returns isSuccess, interactionId and errorMessage. Requires at least one nonblank change.</description>
    <environments>Default</environments>
    <formulas>
        <description>Internal validation requiring an ID and at least one supplied change within field limits.</description>
        <name>validInputs</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!interactionId})), OR(NOT(ISBLANK({!title})), NOT(ISBLANK({!note})), NOT(ISBLANK({!interactionDate}))), LEN({!title}) &lt;= 255, LEN({!note}) &lt;= 32768)</expression>
    </formulas>
    <interviewLabel>MCP Update Interaction Note {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCP Update Interaction Note</label>
    <processMetadataValues>
