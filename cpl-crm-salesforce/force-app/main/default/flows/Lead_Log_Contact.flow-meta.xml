    <description>Logs a CPL Scholar lead contact attempt, optionally emails the lead a follow-up from a starting template, stores contact notes on the Active Contacting task, and advances the lead to Decision when the user clicks Ready for Decision. The lead owner stays with the intake queue.</description>
    <environments>Default</environments>
    <formulas>
        <description>Shows the initial email controls only until the email has been sent or manually marked sent.</description>
        <name>InitialContactEmailControlsVisible</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!Get_Lead.Initial_Contact_Email_Sent__c})</expression>
    </formulas>
    <formulas>
        <description>Lead status after the contacting checkpoint is saved.</description>
        <name>LeadPipelineStatus</name>
        <dataType>String</dataType>
        <expression>&quot;Decision&quot;</expression>
    </formulas>
    <formulas>
        <description>The Ready for Decision footer button is the user&apos;s confirmation.</description>
        <name>ReadyForDecisionButtonClicked</name>
        <dataType>Boolean</dataType>
        <expression>true</expression>
    </formulas>
    <formulas>
        <description>Marks the initial email complete when the user sends it from the flow or records that it was sent elsewhere.</description>
        <name>ShouldMarkInitialContactEmailSent</name>
        <dataType>Boolean</dataType>
        <expression>OR({!Send_Email}, {!Mark_Initial_Email_Sent})</expression>
    </formulas>
