    <recordLookups>
        <name>Get_Intake_Review_Queue</name>
        <label>Get Intake Review Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Recurrence</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intake_Review_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Intake_Review_Queue</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Detailed notes or instructions explaining what needs to be done for the Task.</description>
        <name>description</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Due date for the Task. Provide a Salesforce-compatible date value, for example 2026-10-10.</description>
        <name>dueDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Explains why the task was not created, including input validation errors or Salesforce errors. Blank when task creation succeeds.</description>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Whether to create a recurring task series. If true, provide the recurrence type, start date, end date, and fields required by the selected pattern. If false, leave all other recurrence inputs blank.</description>
        <name>IsRecurrence</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>When IsReminderSet is true, ReminderDateTime is required and must be before the task’s due date. When IsReminderSet is false, ReminderDateTime must be blank</description>
        <name>IsReminderSet</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>True when the task is successfully created. False when validation or task creation fails. If false, read errorMessage for the reason.</description>
        <name>isSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Optional Salesforce User or Intake Queue ID to assign the Task to. If blank, assign the Task to the default Intake Group.</description>
        <name>ownerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Priority</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Calendar day of the month, from 1 to 31. Required for RecursMonthly and RecursYearly. Example: 15 means repeat on the 15th. Only set if IsRecurrence is True.</description>
        <name>recurrenceDayOfMonth</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Numeric weekday selection: Sunday=1, Monday=2, Tuesday=4, Wednesday=8, Thursday=16, Friday=32, Saturday=64. Add values for multiple weekdays; Monday and Friday=34. Used for weekly and ordinal monthly/yearly patterns. For ordinal patterns, select one weekday. Set only if IsRecurrence is True.</description>
        <name>RecurrenceDayOfWeekMask</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Last date through which the task may repeat, in YYYY-MM-DD format. Required when isRecurrence is true.</description>
        <name>RecurrenceEndDateOnly</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Which occurrence of the selected weekday within the month. Use exactly First, Second, Third, Fourth, or Last. Required for RecursMonthlyNth and RecursYearlyNth. Example: Second with weekday mask 2 means the second Monday. Set only if IsRecurrence is True.</description>
        <name>recurrenceInstance</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Positive whole number specifying how often the task repeats. For daily, weekly, or monthly patterns, 1 means every day, week, or month; 2 means every second day, week, or month. Used with RecursDaily, RecursWeekly, RecursMonthly, and RecursMonthlyNth.</description>
        <name>RecurrenceInterval</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Month for a yearly recurrence. Use the full English month name, such as January or October. Required for RecursYearly and RecursYearlyNth. Set only if IsRecurrence is True.</description>
        <name>recurrenceMonthOfYear</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Start date of the recurring series, in YYYY-MM-DD format. Must be before recurrenceEndDate. Required when isRecurrence is true.</description>
        <name>RecurrenceStartDateOnly</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Salesforce time zone identifier for the recurrence schedule, such as America/New_York. Use a supported Salesforce identifier, not an abbreviation such as EST. Set only if IsRecurrence is True.</description>
        <name>recurrenceTimeZone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Recurrence pattern. Use one of these exact values: RecursDaily, RecursEveryWeekday, RecursWeekly, RecursMonthly, RecursMonthlyNth, RecursYearly, or RecursYearlyNth. Required when isRecurrence is true.</description>
        <name>RecurrenceType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>ReminderDateTime: Specifies when the task reminder should trigger. Only set this field when IsReminderSet is True, and choose a date and time before the task’s due date.</description>
        <name>ReminderDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Short title describing the Task, such as Follow up on missing documents.</description>
        <name>subject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Salesforce ID of the newly created Task. Use this ID to retrieve, update, or reference the task. Populated only when isSuccess is true.</description>
        <name>taskId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Salesforce record ID of the related non-person record, such as an Application, Account, Opportunity, or custom object. Do not use this field for Leads or Contacts.</description>
        <name>whatId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Salesforce record ID of the Lead or Contact the Task is related to. Leave blank if the Task is not related to a Lead or Contact.</description>
        <name>whoId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
