        <inputAssignments>
            <field>RecurrenceDayOfMonth</field>
            <value>
                <elementReference>recurrenceDayOfMonth</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecurrenceDayOfWeekMask</field>
            <value>
                <elementReference>RecurrenceDayOfWeekMask</elementReference>
