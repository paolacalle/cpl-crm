<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets to error message to &quot;Task not created. When recurrence is enabled, provide RecurrenceType, RecurrenceStartDateOnly, and RecurrenceEndDateOnly. The end date must be after the start date.&quot;</description>
        <name>Set_Recurrence_Error</name>
        <label>Set Recurrence Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Task not created. When recurrence is enabled, provide RecurrenceType, RecurrenceStartDateOnly, and RecurrenceEndDateOnly. The end date must be after the start date.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets error message to &quot;Task not created. When IsReminderSet is true, provide a dueDate and ReminderDateTime on a date before dueDate. When IsReminderSet is false, leave ReminderDateTime blank.&quot;</description>
        <name>Set_Reminder_Error</name>
        <label>Set Reminder Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Task not created. When IsReminderSet is true, provide a dueDate and ReminderDateTime on a date before dueDate. When IsReminderSet is false, leave ReminderDateTime blank.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets isSuccess to true and stores the newly created Task’s Salesforce ID in taskId.</description>
        <name>Set_Task_Success</name>
        <label>Set Task Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>taskId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Task.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Determines if recurrence is activated and all expected variables are defined.</description>
        <name>Has_Recurrence</name>
        <label>Has Recurrence</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Recurrence_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Error outcome</defaultConnectorLabel>
        <rules>
            <name>Recurrence_enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsRecurrence</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecurrenceType</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecurrenceStartDateOnly</leftValueReference>
                <operator>HasValue</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecurrenceEndDateOnly</leftValueReference>
                <operator>HasValue</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecurrenceEndDateOnly</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>RecurrenceStartDateOnly</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Reminder</targetReference>
            </connector>
            <label>Recurrence enabled</label>
        </rules>
        <rules>
            <name>Recurrence_disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsRecurrence</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Reminder</targetReference>
            </connector>
            <label>Recurrence disabled</label>
        </rules>
    </decisions>
    <decisions>
        <description>Validates if reminder is set, then require a reminder date/time before the due date.</description>
        <name>Has_Reminder</name>
        <label>Has Reminder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Reminder_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Error outcome</defaultConnectorLabel>
        <rules>
            <name>Reminder_enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsReminderSet</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>dueDate</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ReminderDateTime</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>dueDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>ReminderDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
            <label>Reminder enabled</label>
        </rules>
        <rules>
            <name>Reminder_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsReminderSet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
            <label>Reminder Disabled</label>
        </rules>
    </decisions>
    <description>Creates a Salesforce Task with optional recurrence and reminder settings. Assigns the task to the provided ownerId, or defaults to the Intake Review Queue. Validates recurrence and reminder inputs. Returns isSuccess, taskId, and errorMessage so the caller can determine whether task creation succeeded.</description>
    <environments>Default</environments>
    <formulas>
        <description>Optional Salesforce User or Queue ID to assign the Task to. If blank, assign the Task to the default Intake Group.</description>
        <name>SetOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!ownerId}),
    {!Get_Intake_Review_Queue.Id},
    {!ownerId}
)</expression>
    </formulas>
    <interviewLabel>MCP Create Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCP Create Task</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Allows MCP to create a task.</description>
        <name>Create_Task</name>
        <label>Create Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Task_Success</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
