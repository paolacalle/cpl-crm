            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Interaction_Date__c</field>
            <value>
                <elementReference>interactionDate</elementReference>
            </value>
        </inputAssignments>
        <object>Interaction__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Bulk insert outside the loop. No fault connector: failure rolls back this insert AND the interaction.</description>
        <name>Create_Topic_Links</name>
