    <description>Creates one Contact- or Lead-linked interaction and links existing active topics. Never creates topics. Validates before writes; unhandled write faults intentionally roll back the entire transaction. Run synchronously in one transaction. Returns isSuccess, interactionId, errorMessage and topicCount.</description>
    <environments>Default</environments>
    <formulas>
        <description>Internal required-field and exactly-one-parent validation.</description>
        <name>validInputs</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK(TRIM({!title}))), LEN({!title}) &lt;= 255, NOT(ISBLANK(TRIM({!note}))), LEN({!note}) &lt;= 32768, NOT(ISBLANK({!interactionDate})), OR(AND(NOT(ISBLANK({!contactId})), ISBLANK({!leadId})), AND(ISBLANK({!contactId}), NOT(ISBLANK({!leadId})))))</expression>
    </formulas>
    <formulas>
        <description>Internal conversion allowing equivalent 15- and 18-character Topic IDs.</description>
        <name>normalizedRequestedTopicId</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!Validate_Requested_Topics})</expression>
    </formulas>
    <interviewLabel>MCP Create Interaction Note {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCP Create Interaction Note</label>
    <loops>
