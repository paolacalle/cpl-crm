<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Application Email Composer</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="applicationId" type="String" label="Application Id" role="inputOnly"/>
            <property name="emailType" type="String" label="Email Type" role="inputOnly"/>
            <property name="subjectLabel" type="String" label="Subject Label" role="inputOnly"/>
            <property name="bodyLabel" type="String" label="Body Label" role="inputOnly"/>
            <property name="alreadySent" type="Boolean" label="Already Sent" role="inputOnly"/>
            <property name="materialsUrl" type="String" label="Materials URL" role="inputOnly"/>
            <property name="subject" type="String" label="Email Subject"/>
            <property name="body" type="String" label="Email Body"/>
            <property name="emailSubmitted" type="Boolean" label="Email Submitted" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
