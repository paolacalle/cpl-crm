    <decisions>
        <description>Blocks the Contacting status change until the required intake fields are present, so the reviewer gets clear guidance instead of a validation error.</description>
        <name>Intake_Fields_Complete</name>
        <label>Intake Fields Complete?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Intake_Incomplete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Missing Fields</defaultConnectorLabel>
        <rules>
            <name>All_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IntakeComplete</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Intake_Review_Status</targetReference>
            </connector>
            <label>All Present</label>
        </rules>
    </decisions>
    <description>Guides CPL Scholar lead intake users through reviewing applicant details, previewing the uploaded resume, and matching school and sport. On completion the lead advances to Contacting; the lead owner always stays with the intake queue and is never changed.</description>
    <environments>Default</environments>
    <formulas>
        <description>True when the lead meets the intake requirements needed to move out of New.</description>
        <name>IntakeComplete</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!Get_Lead.Email})),
  NOT(ISBLANK({!Get_Lead.School__c})),
  NOT(ISPICKVAL({!Get_Lead.College_Year__c}, &quot;&quot;))
)</expression>
    </formulas>
